---
import { site, sections } from '../site.config';
import { url } from '../lib/url';
import '../styles/global.css';

interface Props {
  lang: 'en' | 'ko';
  title?: string;
}
const { lang, title } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.name;
const path = Astro.url.pathname;
// 메뉴 순서: CV 다음 sections.json 순서. menu: false인 섹션(Notes)은 메뉴에서 뺀다
const nav = [
  { href: url('/cv/'), label: 'CV' },
  ...Object.values(sections)
    .filter((s) => !('menu' in s && s.menu === false))
    .map((s) => ({ href: url(`/${s.path}/`), label: s.title })),
];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={site.description} />
  </head>
  <body>
    <header class="site-header">
      <div class="site-id">
        <a href={url('/')} class="site-name">{site.name}</a>
        <span class="site-fullname">{site.fullName}</span>
      </div>
      <nav aria-label="Main">
        {nav.map((item) => (
          <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      {site.links.map((l) => <a href={l.href}>{l.label}</a>)}
    </footer>
  </body>
</html>
