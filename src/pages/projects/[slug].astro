---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const Content = project.note ? (await render(project.note)).Content : null;
---
<Base lang="en" title={project.title}>
  <article>
    <h1>{project.title}</h1>
    {project.subtitle && <p class="project-subtitle">{project.subtitle}</p>}
    <span class="period">{project.period}</span>
    {Content && <Content />}
  </article>
</Base>
