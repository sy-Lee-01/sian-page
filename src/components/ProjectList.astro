---
import { getCollection } from "astro:content";
// 홈 Projects 카드: me/records/projects.md (CV와 따로)
const projects = (await getCollection("projects")).sort((x, y) => x.id.localeCompare(y.id));
---
{projects.length > 0 && (
  <section>
    <h2>Projects</h2>
    <ul class="project-cards">
      {projects.map(({ data }) => {
        // 'MoonLiver: 3D Surgical Planning Solution' → 제목 MoonLiver, 소제목 뒤쪽
        const [title, ...rest] = data.text.split(': ');
        const subtitle = rest.join(': ');
        const card = (
          <>
            <div class="project-image" aria-hidden="true"></div>
            <div class="project-copy">
              <span class="project-title">{title}</span>
              {subtitle && <span class="project-subtitle">{subtitle}</span>}
              <span class="period">{data.period}</span>
            </div>
          </>
        );
        return <li>{data.link ? <a href={data.link}>{card}</a> : card}</li>;
      })}
    </ul>
  </section>
)}
